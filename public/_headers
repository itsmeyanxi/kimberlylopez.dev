# Default for everything, including clean URLs like /work/sopod/ which do not
# end in .html and so were not matched by a "/*.html" rule. Without this,
# Cloudflare applies its own long edge TTL and a redeploy takes days to reach
# people — a removed page kept being served for a week.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

# Vite fingerprints these, so the URL changes whenever the bytes do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/Kimberly-Lopez-Resume.pdf
  Cache-Control: public, max-age=3600
